{
  "services": [
    {
      "name": "backend",
      "role": "backend",
      "prerequisites": [
        "node scripts/build-sdk.mjs",
        "npm install --install-links"
      ],
      "command": "node server.mjs",
      "cwd": ".",
      "readinessPath": "/api/health"
    },
    {
      "name": "frontend",
      "role": "frontend",
      "prerequisites": [
        "npm install --install-links"
      ],
      "command": "npm run dev:client",
      "cwd": ".",
      "readinessPattern": "ready in",
      "dependsOn": [
        "backend"
      ]
    }
  ]
}
