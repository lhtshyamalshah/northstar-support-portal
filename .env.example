# Variable names only — no real values. Supply them through the platform UI, or in a
# local .env file for laptop development.

# Enables the OpenAI support and billing agents. Unset -> deterministic demo replies.
OPENAI_API_KEY=

# Optional: a model available to your OpenAI project. Defaults to gpt-4.1-mini.
OPENAI_MODEL=

# Injected per service at preview/deploy time. Express binds it; never hardcode it.
PORT=

# Set to "production" to have the Express process also serve the built client from dist/.
NODE_ENV=

# Host port the production compose stack publishes; must stay 3000 on platform deploys —
# the load balancer forwards to it.
APP_PORT=3000

# --- ZBrain Governance SDK ---
# Leave unset or "true" to enforce policy at every agent, model, and tool boundary.
ZBRAIN_GOVERNANCE=

# Injected by the platform before preview and deployment. Never hardcode or commit values.
ZBRAIN_GOVERNANCE_BASE_URL=
ZBRAIN_GOVERNANCE_API_KEY=
ZBRAIN_GOVERNANCE_SOLUTION_ID=
ZBRAIN_GOVERNANCE_DEPLOYMENT_ID=

# Injected by the platform. Comma-separated markers embedded in the agent system prompts so a
# prompt-extraction attempt is detected as a canary leak. Never hardcode a value here or in code.
ZBRAIN_GOVERNANCE_CANARY_TOKEN=

# Optional cron expression for the governance policy-bundle refresh. Defaults to "0 */6 * * *".
CRON_TIME=

# Reserved by the platform for the future governance callback contract. Not read by this app today.
PUBLIC_BASE_URL=
